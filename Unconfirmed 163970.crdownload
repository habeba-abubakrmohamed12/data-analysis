"""
Generates the synthetic raw dataset for the Student Performance & Engagement
Analytics project: data/raw/student_performance_data.xlsx

Design notes (documented here since this is generated, not real, data):
- 40,000 rows, one per student.
- Engagement (App_Login_Count, Video_Completion_Rate) is built to be
  POSITIVELY correlated with Percentage, with noise, so downstream
  correlation/EDA work in notebook 01 has a real signal to find —
  not a flat/random relationship.
- Region and Subject each carry a small built-in performance gap so the
  "which subjects/regions show the biggest gaps" business question has
  a genuine answer to uncover.
- Engagement_Level (Low/Medium/High) is derived from a composite
  engagement score (logins + video completion), matching how the Power BI
  DAX measures in the brief expect to consume it.
"""
import numpy as np
import pandas as pd

RNG_SEED = 42
N = 40_000

rng = np.random.default_rng(RNG_SEED)

# ---- Static reference lists -------------------------------------------------
regions = ["North America", "Europe", "South Asia", "East Asia", "Africa", "South America"]
# small deliberate regional gap (mean percentage shift, points)
region_shift = {
    "North America": 3.0,
    "Europe": 2.0,
    "South Asia": -4.0,
    "East Asia": 4.5,
    "Africa": -6.0,
    "South America": -1.0,
}

subjects = ["Mathematics", "Science", "English", "History", "Computer Science", "Economics"]
subject_shift = {
    "Mathematics": -3.0,
    "Science": 0.0,
    "English": 2.0,
    "History": 1.0,
    "Computer Science": 4.0,
    "Economics": -1.5,
}

genders = ["Male", "Female", "Other"]
gender_p = [0.48, 0.48, 0.04]

grade_levels = [9, 10, 11, 12]

# ---- Generate base fields ----------------------------------------------------
student_id = np.arange(1, N + 1)
region = rng.choice(regions, size=N)
subject = rng.choice(subjects, size=N)
gender = rng.choice(genders, size=N, p=gender_p)
grade_level = rng.choice(grade_levels, size=N)
age = np.array([14 + (g - 9) for g in grade_level]) + rng.integers(0, 2, size=N)

# ---- Engagement metrics (drivers) -------------------------------------------
# App_Login_Count: monthly logins, right-skewed-ish via gamma
app_login_count = rng.gamma(shape=4.0, scale=5.0, size=N)
app_login_count = np.clip(app_login_count, 0, 120).round().astype(int)

# Video_Completion_Rate (%): correlated with login count + noise
base_completion = 20 + (app_login_count / 120) * 60
video_completion_rate = np.clip(
    base_completion + rng.normal(0, 12, size=N), 0, 100
).round(1)

# Study hours per week — another engagement-adjacent signal
study_hours_per_week = np.clip(
    rng.normal(8, 4, size=N) + (app_login_count / 120) * 6, 0, 40
).round(1)

# Assignments submitted (%) — also engagement-linked
assignment_submission_rate = np.clip(
    30 + (video_completion_rate * 0.5) + rng.normal(0, 10, size=N), 0, 100
).round(1)

# ---- Academic outcome (Percentage) ------------------------------------------
# Built from a weighted mix of engagement signals + region/subject shift + noise,
# so correlation with engagement is real but not deterministic.
region_effect = np.array([region_shift[r] for r in region])
subject_effect = np.array([subject_shift[s] for s in subject])

engagement_component = (
    (app_login_count / 120) * 25
    + (video_completion_rate / 100) * 25
    + (study_hours_per_week / 40) * 15
    + (assignment_submission_rate / 100) * 15
)

percentage = (
    45  # baseline, calibrated so the mix + noise centers near a realistic ~68-70 avg
    + engagement_component
    + region_effect
    + subject_effect
    + rng.normal(0, 8, size=N)  # noise
)
percentage = np.clip(percentage, 0, 100).round(1)

# ---- Derived engagement level (used directly by the Power BI DAX measures) --
# Tertile split on a composite engagement score so Low/Medium/High land in
# roughly even thirds, rather than being squashed by the login count's skew.
engagement_score = (
    (app_login_count.astype(float) / app_login_count.max()) * 0.5
    + (video_completion_rate / 100) * 0.5
)
low_cut, high_cut = np.quantile(engagement_score, [1 / 3, 2 / 3])
engagement_level = np.select(
    [engagement_score <= low_cut, engagement_score <= high_cut],
    ["Low", "Medium"],
    default="High",
)

# ---- Assemble dataframe -------------------------------------------------------
df = pd.DataFrame(
    {
        "Student_ID": student_id,
        "Region": region,
        "Subject": subject,
        "Gender": gender,
        "Grade_Level": grade_level,
        "Age": age,
        "App_Login_Count": app_login_count,
        "Video_Completion_Rate": video_completion_rate,
        "Study_Hours_Per_Week": study_hours_per_week,
        "Assignment_Submission_Rate": assignment_submission_rate,
        "Percentage": percentage,
        "Engagement_Level": engagement_level,
    }
)

# ---- Inject a small amount of realistic messiness for the Python-cleaning step
# (Notebook 01 is supposed to have something to clean.)
missing_idx = rng.choice(N, size=int(N * 0.015), replace=False)
df.loc[missing_idx, "Video_Completion_Rate"] = np.nan

dup_idx = rng.choice(N, size=25, replace=False)
df = pd.concat([df, df.loc[dup_idx]], ignore_index=True)

out_path = "/home/claude/student-performance-analytics/data/raw/student_performance_data.xlsx"
df.to_excel(out_path, index=False, sheet_name="students")
print(f"Wrote {len(df)} rows to {out_path}")
print(df.head())
print(df.isna().sum())
